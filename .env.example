# -----------------------------------------------------------------------------
# Frontend Configuration (.env.local)
# Copy this file to .env.local and populate with your Supabase credentials.
# Note: SUPABASE_SERVICE_ROLE_KEY is server-only. Never prefix it with NEXT_PUBLIC_.
# -----------------------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
NEXT_PUBLIC_SITE_URL=https://chcomposing.pk

# Server-only key used by the protected inquiry API route.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
