# -----------------------------------------------------------------------------
# Supabase (required for all backend functionality)
# Copy this file to .env.local and populate with your Supabase credentials.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
NEXT_PUBLIC_SITE_URL=https://chcomposing.pk

# Server-only key used by CMS/office write paths (admin API routes).
# Without it, admin edits and office records cannot be persisted.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# -----------------------------------------------------------------------------
# Admin CMS Authentication (server-only)
# ADMIN_USERNAME / ADMIN_PASSWORD provide the bootstrap admin login.
# Long-term, create a Supabase Auth user with a profiles.role of super_admin.
# -----------------------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-in-production-strong-password
ADMIN_SESSION_SECRET=generate-a-secure-random-32-character-secret-here
# Optional: also accepted as the admin username for the Supabase auth fallback
ADMIN_EMAIL=admin@chcomposing.pk

# -----------------------------------------------------------------------------
# Email (optional — reminder confirmation/subscription emails via Resend).
# Server-side email also works through Supabase Edge Functions using these
# same variables configured as Supabase secrets.
# -----------------------------------------------------------------------------
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM_EMAIL="Ch Composing <noreply@chcomposing.pk>"
